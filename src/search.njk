---
layout: layout.njk
title: "Search"
description: "Search this  site"
---

<section class="search-page">
  <h1>Search</h1>

  <noscript>
    <div class="noscript-warning">
      <p><strong>Search requires JavaScript.</strong></p>
      <p>Please enable JavaScript or browse the <a href="/sitemap/">sitemap</a>.</p>
    </div>
  </noscript>

  <form class="search-form" role="search">
    <label for="search-input">Search the site</label>
    <input type="search" id="search-input" placeholder="Type your search..." autofocus>
    <button type="submit">Search</button>
  </form>

  <div id="search-results" aria-live="polite">
    <p>Type something to search...</p>
  </div>
</section>

<style>
  .search-page { max-width: 800px; margin: 0 auto; }
  .search-form { display: flex; gap: 10px; margin: 20px 0; }
  .search-form input { flex: 1; padding: 10px; border: 1px solid var(--color-border, #666); background: var(--color-bg, #fff); color: var(--color-text, #222); }
  .search-form button { padding: 10px 20px; background: var(--color-accent, #333); color: var(--color-bg, #fff); border: none; cursor: pointer; }
  .search-result { padding: 15px; border-bottom: 1px solid var(--color-border, #999); }
  .search-result h3 a { color: var(--color-text, #222); text-decoration: none; }
  .search-result h3 a:hover { text-decoration: underline; }
  .search-result .excerpt { opacity: 0.8; font-size: 0.95em; }
  .noscript-warning { padding: 20px; background: var(--color-card-bg, #f5f5f5); border: 1px solid var(--color-border, #999); }
</style>

<script>
  (function() {
    const input = document.getElementById('search-input');
    const container = document.getElementById('search-results');
    const form = document.querySelector('.search-form');
    if (!input || !container) return;

    let pagefind = null;
    let loaded = false;

    function clearContainer() {
      while (container.firstChild) {
        container.removeChild(container.firstChild);
      }
    }

    function setMessage(text, isError) {
      clearContainer();
      const p = document.createElement('p');
      p.textContent = text;
      if (isError) {
        p.style.color = '#c0392b';
      }
      container.appendChild(p);
    }

    function buildResultList(results, query) {
      clearContainer();

      const info = document.createElement('p');
      info.textContent = `Found ${results.length} result${results.length !== 1 ? 's' : ''} for "${query}":`;
      container.appendChild(info);

      const list = document.createElement('div');
      list.className = 'results-list';

      results.forEach(result => {
        result.data().then(data => {
          const div = document.createElement('div');
          div.className = 'search-result';

          const h3 = document.createElement('h3');
          const a = document.createElement('a');
          a.href = data.url || '#';
          a.textContent = data.meta?.title || 'Untitled';
          h3.appendChild(a);
          div.appendChild(h3);

          if (data.excerpt) {
            const excerpt = document.createElement('div');
            excerpt.className = 'excerpt';
            excerpt.textContent = data.excerpt;
            div.appendChild(excerpt);
          }

          list.appendChild(div);
        });
      });

      container.appendChild(list);
    }

    async function loadPagefind() {
      try {
        const module = await import('/pagefind/pagefind.js');
        pagefind = module.default || module;
        loaded = true;
        setMessage('Search ready. Type something above.');
        return true;
      } catch (_) {
        setMessage('Search index not available. Please try again later.', true);
        return false;
      }
    }

    async function performSearch(query) {
      if (!query || query.length < 2) {
        setMessage('Type at least 2 characters to search...');
        return;
      }

      setMessage('Searching...');

      if (!loaded) {
        const ok = await loadPagefind();
        if (!ok || !pagefind) {
          setMessage('Search is temporarily unavailable.', true);
          return;
        }
      }

      try {
        const search = await pagefind.search(query);
        if (!search || search.results.length === 0) {
          setMessage(`No results found for "${query}".`);
          return;
        }
        buildResultList(search.results, query);
      } catch (_) {
        setMessage('Error performing search. Please try again.', true);
      }
    }

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        performSearch(input.value);
      });
    }

    let timeout;
    input.addEventListener('input', function() {
      clearTimeout(timeout);
      timeout = setTimeout(function() {
        performSearch(input.value);
      }, 300);
    });

    loadPagefind();
  })();
</script>
