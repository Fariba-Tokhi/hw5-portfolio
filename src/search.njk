---
layout: layout.njk
title: "Search"
description: "Search this site"
---

<section class="search-page">
  <h1>Search</h1>

  <noscript>
    <div class="noscript-warning">
      <p><strong>Search requires JavaScript.</strong></p>
      <p>Please enable JavaScript or browse the <a href="/sitemap/">sitemap</a>.</p>
    </div>
  </noscript>

  <form class="search-form" role="search">
    <label for="search-input">Search the site</label>
    <input type="search" id="search-input" placeholder="Type your search..." autofocus>
    <button type="submit">Search</button>
  </form>

  <div id="search-results" aria-live="polite">
    <p>Type something to search...</p>
  </div>
</section>

<script>
  (function() {
    const searchInput = document.getElementById('search-input');
    const resultsContainer = document.getElementById('search-results');
    const form = document.querySelector('.search-form');

    if (!searchInput || !resultsContainer) return;

    let pagefind = null;
    let isLoaded = false;

    function setMessage(text) {
      resultsContainer.textContent = '';
      const p = document.createElement('p');
      p.textContent = text;
      resultsContainer.appendChild(p);
    }

    async function loadPagefind() {
      try {
        const module = await import('/pagefind/pagefind.js');
        pagefind = module.default || module;
        isLoaded = true;
        setMessage('Search ready. Type something above.');
        return true;
      } catch (error) {
        setMessage('Search index not available. Please try again later.');
        return false;
      }
    }

    async function performSearch(query) {
      if (!query || query.length < 2) {
        setMessage('Type at least 2 characters to search...');
        return;
      }

      setMessage('Searching...');

      if (!isLoaded) {
        const loaded = await loadPagefind();
        if (!loaded || !pagefind) {
          setMessage('Search is temporarily unavailable.');
          return;
        }
      }

      try {
        const search = await pagefind.search(query);

        if (!search || search.results.length === 0) {
          resultsContainer.textContent = '';
          const p = document.createElement('p');
          p.append('No results found for "');
          const strong = document.createElement('strong');
          strong.textContent = query;
          p.append(strong, '".');
          resultsContainer.appendChild(p);
          return;
        }

        resultsContainer.textContent = '';

        const summary = document.createElement('p');
        const count = search.results.length;
        summary.append(`Found ${count} result${count !== 1 ? 's' : ''} for "`);
        const summaryStrong = document.createElement('strong');
        summaryStrong.textContent = query;
        summary.append(summaryStrong, '":');
        resultsContainer.appendChild(summary);

        const list = document.createElement('div');
        list.className = 'results-list';

        for (const result of search.results) {
          const data = await result.data();
          const url = data.url || '#';
          const title = data.meta?.title || 'Untitled';
          const excerpt = data.excerpt || '';

          const item = document.createElement('div');
          item.className = 'search-result';

          const h3 = document.createElement('h3');
          const link = document.createElement('a');
          link.href = url;
          link.textContent = title;
          h3.appendChild(link);

          const excerptDiv = document.createElement('div');
          excerptDiv.className = 'excerpt';
          excerptDiv.textContent = excerpt;

          item.append(h3, excerptDiv);
          list.appendChild(item);
        }

        resultsContainer.appendChild(list);

      } catch (error) {
        setMessage('Error performing search. Please try again.');
      }
    }

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        performSearch(searchInput.value);
      });
    }

    let debounceTimeout;
    searchInput.addEventListener('input', function() {
      clearTimeout(debounceTimeout);
      debounceTimeout = setTimeout(function() {
        performSearch(searchInput.value);
      }, 300);
    });

    loadPagefind();

  })();
</script>
