---
layout: layout.njk
title: "Search"
description: "Search this site"
---

<section class="search-page">
  <h1>Search</h1>

  <noscript>
    <div class="noscript-warning">
      <p><strong>Search requires JavaScript.</strong></p>
      <p>Please enable JavaScript or browse the <a href="/sitemap/">sitemap</a>.</p>
    </div>
  </noscript>

  <form class="search-form" role="search">
    <label for="search-input">Search the site</label>
    <input type="search" id="search-input" placeholder="Type your search..." autofocus>
    <button type="submit">Search</button>
  </form>

  <div id="search-results" aria-live="polite">
    <p>Type something to search...</p>
  </div>
</section>

<style>
  .search-page {
    max-width: 800px;
    margin: 0 auto;
  }
  .search-form {
    display: flex;
    gap: 10px;
    margin: 20px 0;
  }
  .search-form input {
    flex: 1;
    padding: 10px;
    border: 1px solid var(--color-border, #666);
    background: var(--color-bg, #fff);
    color: var(--color-text, #222);
  }
  .search-form button {
    padding: 10px 20px;
    background: var(--color-accent, #333);
    color: var(--color-bg, #fff);
    border: none;
    cursor: pointer;
  }
  .search-result {
    padding: 15px;
    border-bottom: 1px solid var(--color-border, #999);
  }
  .search-result h3 a {
    color: var(--color-text, #222);
    text-decoration: none;
  }
  .search-result h3 a:hover {
    text-decoration: underline;
  }
  .search-result .excerpt {
    opacity: 0.8;
    font-size: 0.95em;
  }
  .noscript-warning {
    padding: 20px;
    background: var(--color-card-bg, #f5f5f5);
    border: 1px solid var(--color-border, #999);
  }
</style>

<script>
  (function() {
    const searchInput = document.getElementById('search-input');
    const resultsContainer = document.getElementById('search-results');
    const form = document.querySelector('.search-form');

    if (!searchInput || !resultsContainer) return;

    let pagefind = null;
    let isLoaded = false;

    async function loadPagefind() {
      try {
        const module = await import('/pagefind/pagefind.js');
        pagefind = module.default || module;
        isLoaded = true;
        resultsContainer.innerHTML = '<p>Search ready. Type something above.</p>';
        return true;
      } catch (error) {
        resultsContainer.innerHTML = '<p>Search index not available. Please try again later.</p>';
        return false;
      }
    }

    async function performSearch(query) {
      if (!query || query.length < 2) {
        resultsContainer.innerHTML = '<p>Type at least 2 characters to search...</p>';
        return;
      }

      resultsContainer.innerHTML = '<p>Searching...</p>';

      if (!isLoaded) {
        const loaded = await loadPagefind();
        if (!loaded || !pagefind) {
          resultsContainer.innerHTML = '<p>Search is temporarily unavailable.</p>';
          return;
        }
      }

      try {
        const search = await pagefind.search(query);

        if (!search || search.results.length === 0) {
          resultsContainer.innerHTML = `<p>No results found for "<strong>${query}</strong>".</p>`;
          return;
        }

        let html = `<p>Found ${search.results.length} result${search.results.length !== 1 ? 's' : ''} for "<strong>${query}</strong>":</p>`;
        html += '<div class="results-list">';

        for (const result of search.results) {
          const data = await result.data();
          const url = data.url || '#';
          const title = data.meta?.title || 'Untitled';
          const excerpt = data.excerpt || '';

          html += `
            <div class="search-result">
              <h3><a href="${url}">${title}</a></h3>
              <div class="excerpt">${excerpt}</div>
            </div>
          `;
        }

        html += '</div>';
        resultsContainer.innerHTML = html;

      } catch (error) {
        resultsContainer.innerHTML = '<p>Error performing search. Please try again.</p>';
      }
    }

    if (form) {
      form.addEventListener('submit', function(e) {
        e.preventDefault();
        performSearch(searchInput.value);
      });
    }

    let debounceTimeout;
    searchInput.addEventListener('input', function() {
      clearTimeout(debounceTimeout);
      debounceTimeout = setTimeout(function() {
        performSearch(searchInput.value);
      }, 300);
    });

    loadPagefind();

  })();
</script>