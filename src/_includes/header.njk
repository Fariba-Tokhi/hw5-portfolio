<header data-pagefind-ignore>
  <div class="logo-area">
    <strong>SM</strong>
  </div>
  
  <nav aria-label="Main navigation">
    <ul>
      {% for item in site.navigation %}
      <li>
        <a href="{{ item.url }}" {% if item.url == page.url %}aria-current="page"{% endif %}>
          {{ item.title }}
        </a>
      </li>
      {% endfor %}
      <li class="theme-control">
        <fieldset>
          <legend>Theme</legend>
          <label>
            <input type="radio" name="theme" value="light" class="theme-option">
            ☀️ Light
          </label>
          <label>
            <input type="radio" name="theme" value="dark" class="theme-option">
            🌙 Dark
          </label>
          <label>
            <input type="radio" name="theme" value="system" class="theme-option">
            🌓 System
          </label>
        </fieldset>
      </li>
    </ul>
  </nav>
</header>
