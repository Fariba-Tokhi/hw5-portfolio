<!DOCTYPE html>
<html lang="en">
<head>
  <script>
    (function() {
      try {
        const theme = localStorage.getItem('theme-preference');
        if (theme === 'light') {
          document.documentElement.setAttribute('data-theme', 'light');
          document.documentElement.setAttribute('data-theme-state', 'light');
        } else if (theme === 'dark') {
          document.documentElement.setAttribute('data-theme', 'dark');
          document.documentElement.setAttribute('data-theme-state', 'dark');
        } else {
          // system default
          document.documentElement.setAttribute('data-theme-state', 'system');
        }
      } catch (_) {}
    })();
  </script>
  {% include "head.njk" %}
</head>
<body>
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <div class="site-wrapper">
    {% include "header.njk" %}
    <main id="main-content">{{ content | safe }}</main>
    {% include "footer.njk" %}
  </div>
  <script src="/assets/js/theme-picker.js" type="module"></script>
  <script src="/assets/js/github-activity.js" type="module"></script>
</body>
</html>
